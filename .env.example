# --- imagemcp env (100% free + self-hostable) ---
# Copy to .env and fill in.

# Where downloaded website assets go (relative or absolute).
# Default: ./public/assets
MEDIA_ROOT=./public/assets

# Where manifests / cache / credits live.
STORAGE_DIR=./.storage

# Set to 1 + run `python -m camoufox fetch` to enable stealth browser fallback.
ENABLE_CAMOUFOX=0

# Lossless optimiser (local imageoptimiser project).
# Path defaults to ../imageoptimiser relative to imagemcp.
IMAGEOPTIMISER_PATH=../imageoptimiser
IMGOPT_ENABLED=1
IMGOPT_QUALITY=80

# Optional HTTP proxy (also used by ddgs + camoufox), e.g. http://user:pass@host:3128
# HTTP_PROXY=
# HTTPS_PROXY=

# Caps (all free)
MAX_IMAGE_MB=15
MAX_VIDEO_MB=200
MAX_FILES=100
REQUEST_TIMEOUT_SEC=30
CACHE_TTL_HOURS=24

# Fast video downloads (yt-dlp, direct .mp4 files — needs yt-dlp + ffmpeg on PATH)
YT_DEFAULT_QUALITY=720p
# If a site shows a bot-check, export browser cookies (pick ONE):
# YT_COOKIES_BROWSER=chrome
# YT_COOKIES_FILE=C:/path/to/cookies.txt

# Default license filter for image search. One of:
# None | any | Public | Share | ShareCommercially | Modify | ModifyCommercially
DEFAULT_LICENSE_FILTER=ShareCommercially
