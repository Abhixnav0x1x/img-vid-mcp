{
  "mcpServers": {
    "imagemcp": {
      "command": "python",
      "args": ["<ABSOLUTE_PATH_TO>/img-vid-mcp/server.py"],
      "env": {
        "MEDIA_ROOT": "./public/assets",
        "IMAGEOPTIMISER_PATH": "../imageoptimiser",
        "IMGOPT_ENABLED": "1",
        "ENABLE_CAMOUFOX": "0"
      }
    }
  }
}
